<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Undangan Pernikahan</title>
<meta name="referrer" content="no-referrer">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">

<style>
/* ===================== TEMA (ubah warna di sini) ===================== */
:root{
  --teal:#12303a; --mist:#e9eff0; --brass:#b58a4a; --dust:#c98f8f; --ink:#0d1f25;
  --serif:'Cormorant Garamond', Georgia, serif;
  --sans:'Jost', system-ui, sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--sans);color:var(--ink);background:#0a1a20;-webkit-font-smoothing:antialiased}
body.locked{overflow:hidden}

.phone{position:relative;max-width:430px;margin:0 auto;background:var(--mist);min-height:100dvh;overflow:hidden;box-shadow:0 0 60px rgba(0,0,0,.5)}
section{padding:72px 28px;text-align:center;position:relative}
h1,h2,h3{font-family:var(--serif);font-weight:400;line-height:1.1}
h2{font-size:2.3rem;margin-bottom:18px;color:var(--teal)}
p{line-height:1.7;font-weight:300;font-size:.98rem}
.small{font-size:.85rem;letter-spacing:.04em}

/* ===================== COVER ===================== */
.cover{position:fixed;inset:0;z-index:100;display:flex;justify-content:center}
.cover .inner{width:100%;max-width:430px;position:relative;height:100dvh;overflow:hidden}
.door{position:absolute;top:0;bottom:0;width:50.5%;background:var(--teal);transition:transform 1.4s cubic-bezier(.77,0,.18,1);z-index:1}